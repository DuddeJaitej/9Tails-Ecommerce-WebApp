RAZORPAY_KEY_ID=replace-with-your-rotated-test-key-id
RAZORPAY_KEY_SECRET=replace-with-your-rotated-test-key-secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Set to true once only to replace the password for the ADMIN_EMAIL account on startup.
ADMIN_PASSWORD_RESET_ON_STARTUP=false
ADMIN_PASSWORD_RESET_URL=http://localhost:5500/Home/Admin.html
CUSTOMER_PASSWORD_RESET_URL=http://localhost:5500/Home/Home.html

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-mailbox@gmail.com
SMTP_PASSWORD=use-an-app-password-not-your-mailbox-password
SMTP_FROM=your-mailbox@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
